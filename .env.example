# Copy to .env and fill in. .env is gitignored — never commit the real values.
#
#   PowerShell:  Copy-Item .env.example .env
#
# Generate the two admin values by running, inside the container:
#
#   docker compose exec api python -m app.security.auth "your admin password"
#
# It prints both lines below, ready to paste. The password itself is never
# stored anywhere — only the hash, which cannot be reversed.
#
# While these are empty, the admin analytics routes return 503 and refuse to
# serve. That is deliberate: an unconfigured deployment should have no admin
# access rather than a default one.

ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Origins allowed to call the API from a browser. Add your Cloudflare Pages
# domain here before going live; localhost entries can then be removed.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500
